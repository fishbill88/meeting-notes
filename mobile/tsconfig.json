{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // whisper.rn's exports map has no "." entry and no directory-index
      // resolution for types — Metro resolves these fine at runtime, but
      // tsc needs explicit pointers to the .d.ts files.
      "whisper.rn": ["./node_modules/whisper.rn/lib/typescript/index.d.ts"],
      "whisper.rn/src/realtime-transcription": [
        "./node_modules/whisper.rn/lib/typescript/realtime-transcription/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
